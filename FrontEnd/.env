# ──────────────────────────────────────────────────
# AgentOps — Multi-Agent Business Assistant
# Environment Configuration
# ──────────────────────────────────────────────────
#
# Copy this file to .env and update the values.
# NEVER commit your actual .env file.
#
# How to use:
# For a static HTML setup, you can inject these values
# via a build step or by editing CONFIG in app.js directly.
#
# When migrating to Vite/React, use:
#   import.meta.env.VITE_API_BASE_URL
# ──────────────────────────────────────────────────
# FastAPI backend URL
VITE_API_BASE_URL=http://localhost:8000
# Set to "false" when FastAPI backend is live
VITE_USE_MOCK=true